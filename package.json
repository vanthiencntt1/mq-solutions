{
  "name": "mq-solutions",
  "version": "0.1.0",
  "private": true,
  "description": "MQ Solutions – web tổng đặt khám đa cơ sở (Next.js + PostgreSQL + ApiDatKham)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env worker/index.ts",
    "worker:dev": "tsx watch --env-file-if-exists=.env worker/index.ts",
    "mock:his": "tsx --env-file-if-exists=.env tests/mocks/his/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "check": "eslint . && tsc --noEmit && vitest run",
    "db:extras": "prisma db execute --file prisma/sql/extras.sql --schema prisma/schema.prisma",
    "db:setup": "prisma migrate dev --name init && prisma db execute --file prisma/sql/extras.sql --schema prisma/schema.prisma && tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs",
    "mail:test": "node scripts/test-mail.mjs",
    "admin:reset": "tsx --env-file-if-exists=.env scripts/admin-reset.ts"
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.90.0",
    "bullmq": "^5.81.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "ioredis": "^5.11.1",
    "jose": "^6.1.0",
    "lucide-react": "^0.577.0",
    "next": "^15.5.28",
    "nodemailer": "^7.0.13",
    "otplib": "^12.0.1",
    "pino": "^9.14.0",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "react-hook-form": "^7.66.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.4.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@node-rs/argon2",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "msgpackr-extract"
    ]
  }
}
