{"code":"__filename=\"E:\\\\00_QuanTri\\\\04_Dev-KyThuat\\\\MQweb\\\\mq-solutions\\\\scripts\\\\seed-content.ts\";(()=>{\n\"use strict\";var __defProp=Object.defineProperty;var __name=(target,value)=>__defProp(target,\"name\",{value,configurable:true});var import_node_crypto=require(\"node:crypto\");var import_client=require(\"@prisma/client\");var import_blocks=require(\"../lib/domain/content/blocks\");const prisma=new import_client.PrismaClient;const paragraph=__name(text=>({type:\"paragraph\",content:[{text}]}),\"paragraph\");const heading=__name(text=>({type:\"heading\",level:2,text}),\"heading\");const list=__name((items,ordered=false)=>({type:\"list\",ordered,items:items.map(text=>[{text}])}),\"list\");const link=__name((label,href)=>({type:\"paragraph\",content:[{text:\"Ngu\\u1ED3n: \"},{text:label,href}]}),\"link\");const news=[{slug:\"phong-benh-nao-mo-cau-trong-truong-hoc\",title:\"Tr\\u01B0\\u1EDDng h\\u1ECDc t\\u0103ng c\\u01B0\\u1EDDng ph\\xF2ng b\\u1EC7nh n\\xE3o m\\xF4 c\\u1EA7u: ph\\u1EE5 huynh c\\u1EA7n l\\u01B0u \\xFD g\\xEC?\",excerpt:\"Ho\\u1EA1t \\u0111\\u1ED9ng truy\\u1EC1n th\\xF4ng t\\u1EA1i tr\\u01B0\\u1EDDng nh\\u1EA5n m\\u1EA1nh v\\u1EC7 sinh c\\xE1 nh\\xE2n, theo d\\xF5i tri\\u1EC7u ch\\u1EE9ng v\\xE0 \\u0111\\u01B0a tr\\u1EBB \\u0111i kh\\xE1m s\\u1EDBm khi c\\xF3 d\\u1EA5u hi\\u1EC7u nghi ng\\u1EDD.\",category:\"tin-y-te\",coverUrl:\"/images/minh-hoa/ck-truyen-nhiem.webp\",publishedAt:\"2026-10-27T05:48:00.000Z\",tags:[\"n\\xE3o m\\xF4 c\\u1EA7u\",\"tr\\u01B0\\u1EDDng h\\u1ECDc\",\"ph\\xF2ng b\\u1EC7nh\"],sourceName:\"S\\u1EE9c kh\\u1ECFe & \\u0110\\u1EDDi s\\u1ED1ng, 27/10/2026\",sourceUrl:\"https://suckhoedoisong.vn/cac-truong-tai-tphcm-tang-cuong-phong-benh-nao-mo-cau-169261027113631385.htm\",sections:[{heading:\"Th\\xF4ng tin ph\\xF2ng b\\u1EC7nh \\u0111\\u1EBFn g\\u1EA7n h\\u1ECDc sinh h\\u01A1n\",paragraphs:[\"Cu\\u1ED1i th\\xE1ng 10/2026, nhi\\u1EC1u tr\\u01B0\\u1EDDng t\\u1EA1i TP.HCM ph\\u1ED1i h\\u1EE3p v\\u1EDBi tr\\u1EA1m y t\\u1EBF \\u0111\\u1EC3 h\\u01B0\\u1EDBng d\\u1EABn h\\u1ECDc sinh nh\\u1EADn bi\\u1EBFt b\\u1EC7nh do n\\xE3o m\\xF4 c\\u1EA7u v\\xE0 th\\u1EF1c h\\xE0nh v\\u1EC7 sinh c\\xE1 nh\\xE2n. Ho\\u1EA1t \\u0111\\u1ED9ng di\\u1EC5n ra t\\u1EA1i l\\u1EDBp h\\u1ECDc, \\u0111\\u1ED3ng th\\u1EDDi th\\xF4ng tin \\u0111\\u01B0\\u1EE3c chuy\\u1EC3n \\u0111\\u1EBFn ph\\u1EE5 huynh qua c\\xE1c k\\xEAnh c\\u1EE7a tr\\u01B0\\u1EDDng. Sau khi m\\u1ED9t \\u1ED5 d\\u1ECBch h\\u1ECDc \\u0111\\u01B0\\u1EDDng \\u0111\\u01B0\\u1EE3c ki\\u1EC3m so\\xE1t, vi\\u1EC7c gi\\xE1m s\\xE1t v\\xE0 truy\\u1EC1n th\\xF4ng v\\u1EABn ti\\u1EBFp t\\u1EE5c \\u0111\\u1EC3 gia \\u0111\\xECnh v\\xE0 nh\\xE0 tr\\u01B0\\u1EDDng nh\\u1EADn ra s\\u1EDBm ca nghi ng\\u1EDD.\",\"N\\xE3o m\\xF4 c\\u1EA7u c\\xF3 th\\u1EC3 l\\xE2y qua ti\\u1EBFp x\\xFAc g\\u1EA7n v\\u1EDBi d\\u1ECBch ti\\u1EBFt \\u0111\\u01B0\\u1EDDng h\\xF4 h\\u1EA5p. Ph\\u1EA7n l\\u1EDBn tri\\u1EC7u ch\\u1EE9ng ban \\u0111\\u1EA7u nh\\u01B0 s\\u1ED1t, m\\u1EC7t, \\u0111au \\u0111\\u1EA7u d\\u1EC5 b\\u1ECB nh\\u1EA7m v\\u1EDBi b\\u1EC7nh th\\xF4ng th\\u01B0\\u1EDDng. V\\xEC v\\u1EADy, m\\u1EE5c ti\\xEAu c\\u1EE7a truy\\u1EC1n th\\xF4ng kh\\xF4ng ph\\u1EA3i khi\\u1EBFn h\\u1ECDc sinh hoang mang m\\xE0 gi\\xFAp c\\xE1c em bi\\u1EBFt b\\xE1o ngay cho ng\\u01B0\\u1EDDi l\\u1EDBn khi s\\u1EE9c kh\\u1ECFe thay \\u0111\\u1ED5i, v\\xE0 gi\\xFAp ph\\u1EE5 huynh ph\\u1EA3n \\u1EE9ng \\u0111\\xFAng l\\xFAc.\"]},{heading:\"Nh\\u1EEFng d\\u1EA5u hi\\u1EC7u c\\u1EA7n \\u0111\\u01B0\\u1EE3c \\u0111\\xE1nh gi\\xE1 s\\u1EDBm\",paragraphs:[\"S\\u1ED1t k\\xE8m \\u0111au \\u0111\\u1EA7u d\\u1EEF d\\u1ED9i, n\\xF4n, c\\u1EE9ng g\\xE1y, l\\u01A1 m\\u01A1 ho\\u1EB7c ban xu\\u1EA5t huy\\u1EBFt l\\xE0 nh\\u1EEFng d\\u1EA5u hi\\u1EC7u c\\u1EA7n \\u0111\\u01B0a tr\\u1EBB \\u0111\\u1EBFn c\\u01A1 s\\u1EDF y t\\u1EBF ngay. Kh\\xF4ng n\\xEAn t\\u1EF1 k\\u1EBFt lu\\u1EADn \\u0111\\xF3 ch\\u1EC9 l\\xE0 c\\u1EA3m c\\xFAm, \\u0111\\u1EB7c bi\\u1EC7t khi tr\\u1EBB \\u0111\\xE3 ti\\u1EBFp x\\xFAc g\\u1EA7n v\\u1EDBi ng\\u01B0\\u1EDDi m\\u1EAFc b\\u1EC7nh ho\\u1EB7c c\\xF3 th\\xF4ng b\\xE1o gi\\xE1m s\\xE1t t\\u1EA1i tr\\u01B0\\u1EDDng. Nh\\xE2n vi\\xEAn y t\\u1EBF s\\u1EBD \\u0111\\xE1nh gi\\xE1 t\\xECnh tr\\u1EA1ng, ch\\u1EC9 \\u0111\\u1ECBnh x\\xE9t nghi\\u1EC7m v\\xE0 x\\u1EED tr\\xED ph\\xF9 h\\u1EE3p; gia \\u0111\\xECnh kh\\xF4ng t\\u1EF1 d\\xF9ng kh\\xE1ng sinh d\\u1EF1 ph\\xF2ng.\"]},{heading:\"Vi\\u1EC7c gia \\u0111\\xECnh c\\xF3 th\\u1EC3 l\\xE0m h\\u1EB1ng ng\\xE0y\",paragraphs:[\"Cha m\\u1EB9 n\\xEAn nh\\u1EAFc tr\\u1EBB r\\u1EEDa tay b\\u1EB1ng x\\xE0 ph\\xF2ng, che mi\\u1EC7ng khi ho ho\\u1EB7c h\\u1EAFt h\\u01A1i, kh\\xF4ng d\\xF9ng chung v\\u1EADt d\\u1EE5ng c\\xE1 nh\\xE2n v\\xE0 gi\\u1EEF kh\\xF4ng gian h\\u1ECDc t\\u1EADp th\\xF4ng tho\\xE1ng. Khi tr\\u1EBB s\\u1ED1t ho\\u1EB7c c\\xF3 tri\\u1EC7u ch\\u1EE9ng \\u0111\\u01B0\\u1EDDng h\\xF4 h\\u1EA5p, cho tr\\u1EBB ngh\\u1EC9 h\\u1ECDc v\\xE0 li\\xEAn h\\u1EC7 nh\\xE2n vi\\xEAn y t\\u1EBF \\u0111\\u1EC3 \\u0111\\u01B0\\u1EE3c h\\u01B0\\u1EDBng d\\u1EABn. Ph\\u1EE5 huynh c\\u0169ng c\\xF3 th\\u1EC3 ki\\u1EC3m tra l\\u1ECBch ti\\xEAm ch\\u1EE7ng v\\xE0 h\\u1ECFi b\\xE1c s\\u0129 v\\u1EC1 lo\\u1EA1i v\\u1EAFc xin ph\\xF9 h\\u1EE3p v\\u1EDBi \\u0111\\u1ED9 tu\\u1ED5i, t\\xECnh tr\\u1EA1ng s\\u1EE9c kh\\u1ECFe c\\u1EE7a con.\",\"N\\u1EBFu nh\\u1EADn th\\xF4ng b\\xE1o c\\xF3 ca b\\u1EC7nh \\u1EDF l\\u1EDBp, h\\xE3y theo d\\xF5i s\\u1EE9c kh\\u1ECFe theo h\\u01B0\\u1EDBng d\\u1EABn c\\u1EE7a c\\u01A1 quan y t\\u1EBF v\\xE0 cung c\\u1EA5p th\\xF4ng tin ti\\u1EBFp x\\xFAc trung th\\u1EF1c. S\\u1EF1 ph\\u1ED1i h\\u1EE3p gi\\u1EEFa gia \\u0111\\xECnh, tr\\u01B0\\u1EDDng h\\u1ECDc v\\xE0 tr\\u1EA1m y t\\u1EBF gi\\xFAp nh\\u1EADn di\\u1EC7n ca b\\u1EC7nh s\\u1EDBm, h\\u1EA1n ch\\u1EBF l\\xE2y lan m\\xE0 v\\u1EABn duy tr\\xEC sinh ho\\u1EA1t h\\u1ECDc \\u0111\\u01B0\\u1EDDng an to\\xE0n.\"]}]},{slug:\"an-giang-tang-cuong-phong-sot-xuat-huyet\",title:\"S\\u1ED1t xu\\u1EA5t huy\\u1EBFt gia t\\u0103ng t\\u1EA1i An Giang: ph\\xF2ng mu\\u1ED7i t\\u1EEB t\\u1EEBng h\\u1ED9 gia \\u0111\\xECnh\",excerpt:\"S\\u1ED1 ca s\\u1ED1t xu\\u1EA5t huy\\u1EBFt t\\u0103ng \\u0111\\u1EB7t ra y\\xEAu c\\u1EA7u x\\u1EED l\\xFD n\\u01A1i mu\\u1ED7i sinh s\\u1EA3n \\u0111\\u1EC1u \\u0111\\u1EB7n v\\xE0 theo d\\xF5i s\\xE1t ng\\u01B0\\u1EDDi s\\u1ED1t, nh\\u1EA5t l\\xE0 tr\\u1EBB em.\",category:\"tin-y-te\",coverUrl:\"/images/minh-hoa/ck-truyen-nhiem.webp\",publishedAt:\"2026-10-16T05:01:00.000Z\",tags:[\"s\\u1ED1t xu\\u1EA5t huy\\u1EBFt\",\"Dengue\",\"ph\\xF2ng d\\u1ECBch\"],sourceName:\"S\\u1EE9c kh\\u1ECFe & \\u0110\\u1EDDi s\\u1ED1ng, 16/10/2026\",sourceUrl:\"https://suckhoedoisong.vn/an-giang-ghi-nhan-hon-7000-ca-mac-sot-xuat-huyet-1-truong-hop-tu-vong-169261016114920718.htm\",sections:[{heading:\"S\\u1ED1 ca m\\u1EAFc v\\xE0 nguy c\\u01A1 \\u1EDF tr\\u1EBB em\",paragraphs:[\"Theo th\\xF4ng tin c\\xF4ng b\\u1ED1 gi\\u1EEFa th\\xE1ng 10/2026, An Giang \\u0111\\xE3 ghi nh\\u1EADn h\\u01A1n 7.000 ca s\\u1ED1t xu\\u1EA5t huy\\u1EBFt v\\xE0 m\\u1ED9t tr\\u01B0\\u1EDDng h\\u1EE3p t\\u1EED vong. Trong nh\\xF3m ca nh\\u1EB9 ho\\u1EB7c c\\xF3 d\\u1EA5u hi\\u1EC7u c\\u1EA3nh b\\xE1o, tr\\u1EBB t\\u1EEB 15 tu\\u1ED5i tr\\u1EDF xu\\u1ED1ng chi\\u1EBFm h\\u01A1n m\\u1ED9t n\\u1EEDa; \\u1EDF nh\\xF3m b\\u1EC7nh n\\u1EB7ng, t\\u1EF7 l\\u1EC7 tr\\u1EBB c\\xF2n cao h\\u01A1n. S\\u1ED1 m\\u1EAFc t\\u0103ng \\u1EDF nhi\\u1EC1u \\u0111\\u1ECBa b\\xE0n, cho th\\u1EA5y vi\\u1EC7c ph\\xF2ng d\\u1ECBch ph\\u1EA3i \\u0111\\u01B0\\u1EE3c duy tr\\xEC th\\u01B0\\u1EDDng xuy\\xEAn ngay c\\u1EA3 t\\u1EA1i n\\u01A1i \\u0111ang ghi nh\\u1EADn \\xEDt ca.\",\"S\\u1ED1t xu\\u1EA5t huy\\u1EBFt Dengue do mu\\u1ED7i truy\\u1EC1n. Nguy c\\u01A1 kh\\xF4ng ch\\u1EC9 n\\u1EB1m \\u1EDF nh\\u1EEFng ao t\\xF9 d\\u1EC5 th\\u1EA5y: ch\\u1EADu c\\xE2y, x\\xF4, khay n\\u01B0\\u1EDBc v\\xE0 c\\xE1c v\\u1EADt d\\u1EE5ng \\u0111\\u1ECDng n\\u01B0\\u1EDBc quanh nh\\xE0 c\\u0169ng c\\xF3 th\\u1EC3 tr\\u1EDF th\\xE0nh ch\\u1ED7 mu\\u1ED7i sinh s\\u1EA3n. M\\u1ED9t \\u0111\\u1EE3t phun h\\xF3a ch\\u1EA5t kh\\xF4ng th\\u1EC3 thay cho vi\\u1EC7c lo\\u1EA1i b\\u1ECF l\\u0103ng qu\\u0103ng tr\\u01B0\\u1EDBc v\\xE0 sau x\\u1EED l\\xFD \\u1ED5 d\\u1ECBch.\"]},{heading:\"Ch\\u1EE7 \\u0111\\u1ED9ng x\\u1EED l\\xFD ngu\\u1ED3n mu\\u1ED7i\",paragraphs:[\"M\\u1ED7i gia \\u0111\\xECnh n\\xEAn d\\xE0nh th\\u1EDDi gian ki\\u1EC3m tra, \\u0111\\u1EADy k\\xEDn d\\u1EE5ng c\\u1EE5 ch\\u1EE9a n\\u01B0\\u1EDBc, thay n\\u01B0\\u1EDBc b\\xECnh hoa, c\\u1ECD r\\u1EEDa th\\xE0nh v\\u1EADt ch\\u1EE9a v\\xE0 lo\\u1EA1i b\\u1ECF \\u0111\\u1ED3 ph\\u1EBF th\\u1EA3i c\\xF3 th\\u1EC3 t\\xEDch n\\u01B0\\u1EDBc m\\u01B0a. Ban ng\\xE0y c\\u0169ng c\\u1EA7n ph\\xF2ng mu\\u1ED7i \\u0111\\u1ED1t b\\u1EB1ng qu\\u1EA7n \\xE1o che k\\xEDn, l\\u01B0\\u1EDBi ho\\u1EB7c bi\\u1EC7n ph\\xE1p xua mu\\u1ED7i ph\\xF9 h\\u1EE3p. Khi \\u0111\\u1ECBa ph\\u01B0\\u01A1ng tri\\u1EC3n khai gi\\xE1m s\\xE1t ho\\u1EB7c x\\u1EED l\\xFD \\u1ED5 d\\u1ECBch, ng\\u01B0\\u1EDDi d\\xE2n n\\xEAn ph\\u1ED1i h\\u1EE3p \\u0111\\u1EC3 \\u0111\\u1ED9i y t\\u1EBF ti\\u1EBFp c\\u1EADn \\u0111\\xFAng \\u0111i\\u1EC3m nguy c\\u01A1.\"]},{heading:\"Theo d\\xF5i ng\\u01B0\\u1EDDi s\\u1ED1t \\u0111\\xFAng c\\xE1ch\",paragraphs:[\"Ng\\u01B0\\u1EDDi s\\u1ED1t cao, \\u0111au \\u0111\\u1EA7u, \\u0111au m\\u1ECFi ng\\u01B0\\u1EDDi, nh\\u1EA5t l\\xE0 \\u0111ang s\\u1ED1ng ho\\u1EB7c v\\u1EEBa \\u0111\\u1EBFn v\\xF9ng c\\xF3 d\\u1ECBch, n\\xEAn \\u0111i kh\\xE1m \\u0111\\u1EC3 \\u0111\\u01B0\\u1EE3c \\u0111\\xE1nh gi\\xE1 nguy\\xEAn nh\\xE2n. C\\u1EA7n theo d\\xF5i li\\xEAn t\\u1EE5c c\\u1EA3 khi \\u0111\\xE3 h\\u1EA1 s\\u1ED1t, v\\xEC b\\u1EC7nh c\\xF3 th\\u1EC3 chuy\\u1EC3n n\\u1EB7ng \\u1EDF giai \\u0111o\\u1EA1n sau. \\u0110au b\\u1EE5ng nhi\\u1EC1u, n\\xF4n li\\xEAn t\\u1EE5c, ch\\u1EA3y m\\xE1u, li b\\xEC, tay ch\\xE2n l\\u1EA1nh ho\\u1EB7c kh\\xF3 th\\u1EDF l\\xE0 l\\xFD do ph\\u1EA3i \\u0111\\u1EBFn c\\u01A1 s\\u1EDF y t\\u1EBF ngay.\",\"Kh\\xF4ng t\\u1EF1 truy\\u1EC1n d\\u1ECBch t\\u1EA1i nh\\xE0 hay d\\xF9ng thu\\u1ED1c kh\\xF4ng \\u0111\\u01B0\\u1EE3c b\\xE1c s\\u0129 ch\\u1EC9 \\u0111\\u1ECBnh. V\\u1EDBi tr\\u1EBB nh\\u1ECF, ng\\u01B0\\u1EDDi mang thai v\\xE0 ng\\u01B0\\u1EDDi c\\xF3 b\\u1EC7nh n\\u1EC1n, gia \\u0111\\xECnh c\\xE0ng c\\u1EA7n h\\u1ECFi nh\\xE2n vi\\xEAn y t\\u1EBF v\\u1EC1 l\\u1ECBch theo d\\xF5i v\\xE0 th\\u1EDDi \\u0111i\\u1EC3m t\\xE1i kh\\xE1m. Ph\\xF2ng mu\\u1ED7i v\\xE0 ph\\xE1t hi\\u1EC7n s\\u1EDBm ca n\\u1EB7ng l\\xE0 hai vi\\u1EC7c b\\u1ED5 sung cho nhau, gi\\xFAp gi\\u1EA3m nguy c\\u01A1 l\\xE2y truy\\u1EC1n l\\u1EABn bi\\u1EBFn ch\\u1EE9ng.\"]}]},{slug:\"cum-o-tre-tang-cach-han-che-lay-trong-gia-dinh\",title:\"Ca c\\xFAm \\u1EDF tr\\u1EBB t\\u0103ng: c\\xE1ch h\\u1EA1n ch\\u1EBF l\\xE2y trong gia \\u0111\\xECnh v\\xE0 tr\\u01B0\\u1EDDng h\\u1ECDc\",excerpt:\"C\\xFAm c\\xF3 th\\u1EC3 g\\xE2y b\\u1EC7nh n\\u1EB7ng \\u1EDF nh\\xF3m d\\u1EC5 t\\u1ED5n th\\u01B0\\u01A1ng; ti\\xEAm ph\\xF2ng, ngh\\u1EC9 h\\u1ECDc khi \\u1ED1m, v\\u1EC7 sinh tay v\\xE0 th\\xF4ng kh\\xED gi\\xFAp gi\\u1EA3m chu\\u1ED7i l\\xE2y.\",category:\"tin-y-te\",coverUrl:\"/images/minh-hoa/ck-tiem-chung.webp\",publishedAt:\"2026-10-10T02:12:00.000Z\",tags:[\"c\\xFAm m\\xF9a\",\"tr\\u1EBB em\",\"ti\\xEAm ch\\u1EE7ng\"],sourceName:\"S\\u1EE9c kh\\u1ECFe & \\u0110\\u1EDDi s\\u1ED1ng, 10/10/2026\",sourceUrl:\"https://suckhoedoisong.vn/tang-tre-nhap-vien-vi-cum-dung-de-mot-dot-bung-phat-tro-thanh-vong-xoay-benh-169261008104052238.htm\",sections:[{heading:\"Khi s\\u1ED1 tr\\u1EBB m\\u1EAFc c\\xFAm t\\u0103ng nhanh\",paragraphs:[\"M\\u1ED9t b\\xE1o c\\xE1o \\u0111\\u01B0\\u1EE3c S\\u1EE9c kh\\u1ECFe & \\u0110\\u1EDDi s\\u1ED1ng d\\u1EABn l\\u1EA1i cho th\\u1EA5y s\\u1ED1 tr\\u1EBB d\\u01B0\\u01A1ng t\\xEDnh v\\u1EDBi c\\xFAm A trong tu\\u1EA7n 40/2026 cao h\\u01A1n b\\u1EA3y l\\u1EA7n so v\\u1EDBi tu\\u1EA7n 35, trong khi s\\u1ED1 tr\\u1EBB ph\\u1EA3i nh\\u1EADp vi\\u1EC7n t\\u0103ng t\\u1EEB 18 l\\xEAn 124. \\u0110\\xE2y l\\xE0 s\\u1ED1 li\\u1EC7u t\\u1EA1i m\\u1ED9t c\\u01A1 s\\u1EDF \\u0111\\u01B0\\u1EE3c theo d\\xF5i, kh\\xF4ng ph\\u1EA3i t\\u1EF7 l\\u1EC7 m\\u1EAFc c\\u1EE7a t\\u1EA5t c\\u1EA3 tr\\u1EBB em. D\\xF9 v\\u1EADy, di\\u1EC5n bi\\u1EBFn n\\xE0y nh\\u1EAFc c\\xE1c gia \\u0111\\xECnh ch\\xFA \\xFD ph\\xF2ng l\\xE2y khi m\\xF9a b\\u1EC7nh thay \\u0111\\u1ED5i.\",\"C\\xFAm l\\xE0 b\\u1EC7nh nhi\\u1EC5m virus \\u0111\\u01B0\\u1EDDng h\\xF4 h\\u1EA5p, th\\u01B0\\u1EDDng g\\xE2y s\\u1ED1t, ho, \\u0111au h\\u1ECDng, m\\u1EC7t v\\xE0 \\u0111au nh\\u1EE9c. Nhi\\u1EC1u tr\\u01B0\\u1EDDng h\\u1EE3p t\\u1EF1 h\\u1ED3i ph\\u1EE5c nh\\u01B0ng tr\\u1EBB nh\\u1ECF, ng\\u01B0\\u1EDDi cao tu\\u1ED5i, thai ph\\u1EE5 v\\xE0 ng\\u01B0\\u1EDDi c\\xF3 b\\u1EC7nh m\\u1EA1n t\\xEDnh c\\xF3 nguy c\\u01A1 bi\\u1EBFn ch\\u1EE9ng cao h\\u01A1n. Virus c\\u0169ng c\\xF3 th\\u1EC3 l\\xE0m b\\u1EC7nh n\\u1EC1n n\\u1EB7ng l\\xEAn ho\\u1EB7c t\\u1EA1o \\u0111i\\u1EC1u ki\\u1EC7n cho b\\u1ED9i nhi\\u1EC5m. V\\xEC th\\u1EBF, theo d\\xF5i ng\\u01B0\\u1EDDi \\u1ED1m v\\xE0 gi\\u1EA3m ti\\u1EBFp x\\xFAc g\\u1EA7n l\\xE0 vi\\u1EC7c c\\u1EA7n l\\xE0m ngay t\\u1EEB nh\\u1EEFng ng\\xE0y \\u0111\\u1EA7u.\"]},{heading:\"C\\u1EAFt \\u0111\\u01B0\\u1EDDng l\\xE2y t\\u1EA1i nh\\xE0 v\\xE0 tr\\u01B0\\u1EDDng\",paragraphs:[\"Khi tr\\u1EBB b\\u1ECB s\\u1ED1t ho\\u1EB7c c\\xF3 tri\\u1EC7u ch\\u1EE9ng c\\xFAm, n\\xEAn cho tr\\u1EBB ngh\\u1EC9 h\\u1ECDc, ngh\\u1EC9 ng\\u01A1i v\\xE0 li\\xEAn h\\u1EC7 b\\xE1c s\\u0129 n\\u1EBFu c\\u1EA7n. Ng\\u01B0\\u1EDDi ch\\u0103m s\\xF3c r\\u1EEDa tay th\\u01B0\\u1EDDng xuy\\xEAn, che mi\\u1EC7ng khi ho, v\\u1EC7 sinh b\\u1EC1 m\\u1EB7t hay ch\\u1EA1m v\\xE0o v\\xE0 m\\u1EDF c\\u1EEDa th\\xF4ng kh\\xED khi \\u0111i\\u1EC1u ki\\u1EC7n cho ph\\xE9p. H\\u1EA1n ch\\u1EBF \\u0111\\u1EC3 tr\\u1EBB \\u1ED1m ti\\u1EBFp x\\xFAc g\\u1EA7n v\\u1EDBi ng\\u01B0\\u1EDDi l\\u1EDBn tu\\u1ED5i ho\\u1EB7c ng\\u01B0\\u1EDDi c\\xF3 b\\u1EC7nh n\\u1EC1n. Tr\\u01B0\\u1EDDng h\\u1ECDc c\\u0169ng n\\xEAn c\\xF3 c\\xE1ch th\\xF4ng b\\xE1o v\\xE0 h\\u1ED7 tr\\u1EE3 h\\u1ECDc sinh ngh\\u1EC9 \\u1EDF nh\\xE0 khi \\u0111ang b\\u1EC7nh.\"]},{heading:\"Ti\\xEAm ph\\xF2ng v\\xE0 nh\\u1EADn bi\\u1EBFt l\\xFAc c\\u1EA7n \\u0111i kh\\xE1m\",paragraphs:[\"Ti\\xEAm v\\u1EAFc xin c\\xFAm h\\u1EB1ng n\\u0103m l\\xE0 bi\\u1EC7n ph\\xE1p d\\u1EF1 ph\\xF2ng quan tr\\u1ECDng, nh\\u1EA5t l\\xE0 \\u1EDF nh\\xF3m c\\xF3 nguy c\\u01A1 b\\u1EC7nh n\\u1EB7ng. Gia \\u0111\\xECnh n\\xEAn h\\u1ECFi nh\\xE2n vi\\xEAn y t\\u1EBF v\\u1EC1 th\\u1EDDi \\u0111i\\u1EC3m v\\xE0 lo\\u1EA1i v\\u1EAFc xin ph\\xF9 h\\u1EE3p v\\u1EDBi t\\u1EEBng th\\xE0nh vi\\xEAn. V\\u1EAFc xin kh\\xF4ng b\\u1EA3o \\u0111\\u1EA3m tr\\xE1nh m\\u1ECDi ca nhi\\u1EC5m, nh\\u01B0ng gi\\xFAp gi\\u1EA3m nguy c\\u01A1 b\\u1EC7nh n\\u1EB7ng v\\xE0 nh\\u1EADp vi\\u1EC7n.\",\"N\\u1EBFu ng\\u01B0\\u1EDDi b\\u1EC7nh kh\\xF3 th\\u1EDF, th\\u1EDF nhanh, l\\u01A1 m\\u01A1, m\\u1EA5t n\\u01B0\\u1EDBc, s\\u1ED1t k\\xE9o d\\xE0i ho\\u1EB7c tri\\u1EC7u ch\\u1EE9ng n\\u1EB7ng l\\xEAn sau khi \\u0111\\xE3 \\u0111\\u1EE1, h\\xE3y \\u0111i kh\\xE1m s\\u1EDBm. Kh\\xF4ng t\\u1EF1 mua kh\\xE1ng sinh v\\xEC thu\\u1ED1c n\\xE0y kh\\xF4ng \\u0111i\\u1EC1u tr\\u1ECB virus c\\xFAm. S\\u1EF1 k\\u1EBFt h\\u1EE3p gi\\u1EEFa ti\\xEAm ph\\xF2ng, ch\\u0103m s\\xF3c \\u0111\\xFAng c\\xE1ch v\\xE0 \\u1EDF nh\\xE0 khi \\u1ED1m gi\\xFAp b\\u1EA3o v\\u1EC7 c\\u1EA3 gia \\u0111\\xECnh l\\u1EABn c\\u1ED9ng \\u0111\\u1ED3ng.\"]}]},{slug:\"nguoi-cao-tuoi-can-theo-doi-huyet-ap-dinh-ky\",title:\"Nhi\\u1EC1u ng\\u01B0\\u1EDDi cao tu\\u1ED5i c\\xF3 d\\u1EA5u hi\\u1EC7u li\\xEAn quan t\\u0103ng huy\\u1EBFt \\xE1p: c\\u1EA7n theo d\\xF5i th\\u1EBF n\\xE0o?\",excerpt:\"D\\u1EEF li\\u1EC7u kh\\xE1m s\\u1EE9c kh\\u1ECFe t\\u1EA1i TP.HCM g\\u1EE3i \\xFD nhu c\\u1EA7u \\u0111o huy\\u1EBFt \\xE1p \\u0111\\u1ECBnh k\\u1EF3 v\\xE0 \\u0111\\xE1nh gi\\xE1 y khoa, thay v\\xEC t\\u1EF1 k\\u1EBFt lu\\u1EADn t\\u1EEB m\\u1ED9t l\\u1EA7n \\u0111o.\",category:\"y-hoc-thuong-thuc\",coverUrl:\"/images/minh-hoa/ck-tim-mach.webp\",publishedAt:\"2026-10-12T04:02:00.000Z\",tags:[\"t\\u0103ng huy\\u1EBFt \\xE1p\",\"ng\\u01B0\\u1EDDi cao tu\\u1ED5i\",\"kh\\xE1m \\u0111\\u1ECBnh k\\u1EF3\"],sourceName:\"VnExpress S\\u1EE9c kh\\u1ECFe, 12/10/2026\",sourceUrl:\"https://vnexpress.net/tang-huyet-ap-go-cua-nhieu-nguoi-cao-tuoi-tp-hcm-5131119.html\",sections:[{heading:\"Hi\\u1EC3u \\u0111\\xFAng s\\u1ED1 li\\u1EC7u s\\xE0ng l\\u1ECDc\",paragraphs:[\"Trong h\\u01A1n 663.000 ng\\u01B0\\u1EDDi t\\u1EEB 60 tu\\u1ED5i tr\\u1EDF l\\xEAn c\\xF3 d\\u1EEF li\\u1EC7u \\u0111\\u01B0\\u1EE3c ph\\xE2n t\\xEDch t\\u1EEB ch\\u01B0\\u01A1ng tr\\xECnh kh\\xE1m s\\u1EE9c kh\\u1ECFe t\\u1EA1i TP.HCM, kho\\u1EA3ng 51% \\u0111\\u01B0\\u1EE3c ghi nh\\u1EADn th\\xF4ng tin li\\xEAn quan \\u0111\\u1EBFn t\\u0103ng huy\\u1EBFt \\xE1p. Nh\\xF3m th\\xF4ng tin n\\xE0y bao g\\u1ED3m ti\\u1EC1n s\\u1EED b\\u1EC7nh, huy\\u1EBFt \\xE1p t\\u0103ng t\\u1EA1i l\\u1EA7n kh\\xE1m ho\\u1EB7c ch\\u1EA9n \\u0111o\\xE1n s\\u01A1 b\\u1ED9. Con s\\u1ED1 kh\\xF4ng c\\xF3 ngh\\u0129a m\\u1ED9t n\\u1EEDa to\\xE0n b\\u1ED9 ng\\u01B0\\u1EDDi cao tu\\u1ED5i c\\u1EE7a th\\xE0nh ph\\u1ED1 \\u0111\\xE3 \\u0111\\u01B0\\u1EE3c x\\xE1c \\u0111\\u1ECBnh m\\u1EAFc b\\u1EC7nh; nh\\u1EEFng tr\\u01B0\\u1EDDng h\\u1EE3p nghi ng\\u1EDD c\\xF2n c\\u1EA7n \\u0111\\u01B0\\u1EE3c \\u0111o v\\xE0 \\u0111\\xE1nh gi\\xE1 th\\xEAm.\",\"\\u1EDE nh\\xF3m 18\\u201359 tu\\u1ED5i, t\\u1EF7 l\\u1EC7 c\\xF3 y\\u1EBFu t\\u1ED1 li\\xEAn quan th\\u1EA5p h\\u01A1n nh\\u01B0ng v\\u1EABn \\u0111\\xE1ng ch\\xFA \\xFD. D\\u1EEF li\\u1EC7u s\\xE0ng l\\u1ECDc gi\\xFAp c\\u01A1 quan y t\\u1EBF nh\\u1EADn di\\u1EC7n ng\\u01B0\\u1EDDi c\\u1EA7n theo d\\xF5i, \\u0111\\u1ED3ng th\\u1EDDi nh\\u1EAFc m\\u1ED7i c\\xE1 nh\\xE2n r\\u1EB1ng huy\\u1EBFt \\xE1p cao c\\xF3 th\\u1EC3 kh\\xF4ng g\\xE2y tri\\u1EC7u ch\\u1EE9ng r\\xF5. Kh\\xF4ng n\\xEAn \\u0111\\u1EE3i \\u0111\\u1EBFn khi \\u0111au \\u0111\\u1EA7u hay m\\u1EC7t m\\u1EDBi ki\\u1EC3m tra.\"]},{heading:\"Theo d\\xF5i huy\\u1EBFt \\xE1p c\\xF3 h\\u1EC7 th\\u1ED1ng\",paragraphs:[\"N\\u1EBFu t\\u1EEBng c\\xF3 k\\u1EBFt qu\\u1EA3 cao, h\\xE3y trao \\u0111\\u1ED5i v\\u1EDBi b\\xE1c s\\u0129 v\\u1EC1 c\\xE1ch \\u0111o t\\u1EA1i nh\\xE0, th\\u1EDDi \\u0111i\\u1EC3m \\u0111o v\\xE0 vi\\u1EC7c ghi l\\u1EA1i nhi\\u1EC1u l\\u1EA7n \\u0111o. Ng\\u1ED3i ngh\\u1EC9 tr\\u01B0\\u1EDBc khi \\u0111o, \\u0111\\u1EB7t tay \\u0111\\xFAng t\\u01B0 th\\u1EBF v\\xE0 d\\xF9ng thi\\u1EBFt b\\u1ECB ph\\xF9 h\\u1EE3p gi\\xFAp gi\\u1EA3m sai l\\u1EC7ch. B\\xE1c s\\u0129 c\\xF3 th\\u1EC3 xem th\\xEAm ti\\u1EC1n s\\u1EED b\\u1EC7nh, thu\\u1ED1c \\u0111ang d\\xF9ng v\\xE0 nh\\u1EEFng y\\u1EBFu t\\u1ED1 nguy c\\u01A1 kh\\xE1c \\u0111\\u1EC3 quy\\u1EBFt \\u0111\\u1ECBnh c\\xF3 c\\u1EA7n x\\xE9t nghi\\u1EC7m hay theo d\\xF5i th\\xEAm hay kh\\xF4ng.\"]},{heading:\"Ki\\u1EC3m so\\xE1t nguy c\\u01A1 l\\xE2u d\\xE0i\",paragraphs:[\"Ng\\u01B0\\u1EDDi \\u0111\\xE3 \\u0111\\u01B0\\u1EE3c ch\\u1EA9n \\u0111o\\xE1n t\\u0103ng huy\\u1EBFt \\xE1p n\\xEAn d\\xF9ng thu\\u1ED1c v\\xE0 t\\xE1i kh\\xE1m theo \\u0111\\u01A1n, k\\u1EC3 c\\u1EA3 khi th\\u1EA5y kh\\u1ECFe. T\\u1EF1 ng\\u1EEBng thu\\u1ED1c v\\xEC m\\u1ED9t v\\xE0i l\\u1EA7n \\u0111o b\\xECnh th\\u01B0\\u1EDDng c\\xF3 th\\u1EC3 khi\\u1EBFn huy\\u1EBFt \\xE1p t\\u0103ng tr\\u1EDF l\\u1EA1i. B\\xEAn c\\u1EA1nh \\u0111i\\u1EC1u tr\\u1ECB, gi\\u1EA3m mu\\u1ED1i, v\\u1EADn \\u0111\\u1ED9ng ph\\xF9 h\\u1EE3p, h\\u1EA1n ch\\u1EBF thu\\u1ED1c l\\xE1 v\\xE0 r\\u01B0\\u1EE3u bia, ng\\u1EE7 \\u0111\\u1EE7 v\\xE0 ki\\u1EC3m so\\xE1t c\\xE2n n\\u1EB7ng l\\xE0 nh\\u1EEFng b\\u01B0\\u1EDBc c\\xF3 \\xEDch cho s\\u1EE9c kh\\u1ECFe tim m\\u1EA1ch.\",\"Khi xu\\u1EA5t hi\\u1EC7n \\u0111au ng\\u1EF1c, kh\\xF3 th\\u1EDF, y\\u1EBFu li\\u1EC7t \\u0111\\u1ED9t ng\\u1ED9t, n\\xF3i kh\\xF3 ho\\u1EB7c \\u0111au \\u0111\\u1EA7u d\\u1EEF d\\u1ED9i b\\u1EA5t th\\u01B0\\u1EDDng, c\\u1EA7n t\\xECm tr\\u1EE3 gi\\xFAp y t\\u1EBF kh\\u1EA9n c\\u1EA5p. Vi\\u1EC7c ki\\u1EC3m tra \\u0111\\u1ECBnh k\\u1EF3 gi\\xFAp ph\\xE1t hi\\u1EC7n s\\u1EDBm v\\xE0 \\u0111i\\u1EC1u ch\\u1EC9nh \\u0111i\\u1EC1u tr\\u1ECB tr\\u01B0\\u1EDBc khi bi\\u1EBFn ch\\u1EE9ng x\\u1EA3y ra; k\\u1EBFt qu\\u1EA3 t\\u1EF1 \\u0111o ch\\u1EC9 l\\xE0 m\\u1ED9t ph\\u1EA7n th\\xF4ng tin cho cu\\u1ED9c trao \\u0111\\u1ED5i v\\u1EDBi nh\\xE2n vi\\xEAn y t\\u1EBF.\"]}]},{slug:\"ho-so-suc-khoe-dien-tu-ho-tro-phat-hien-nguy-co\",title:\"H\\u1ED3 s\\u01A1 s\\u1EE9c kh\\u1ECFe \\u0111i\\u1EC7n t\\u1EED gi\\xFAp nh\\u1EADn di\\u1EC7n s\\u1EDBm nguy c\\u01A1 b\\u1EC7nh m\\u1EA1n t\\xEDnh\",excerpt:\"Ph\\xE2n t\\xEDch d\\u1EEF li\\u1EC7u kh\\xE1m s\\u1EE9c kh\\u1ECFe t\\u1EA1i TP.HCM cho th\\u1EA5y gi\\xE1 tr\\u1ECB c\\u1EE7a s\\xE0ng l\\u1ECDc tim m\\u1EA1ch, th\\u1EADn v\\xE0 \\u0111\\u01B0\\u1EDDng huy\\u1EBFt khi k\\u1EBFt h\\u1EE3p theo d\\xF5i sau kh\\xE1m.\",category:\"tin-y-te\",coverUrl:\"/images/minh-hoa/ck-kham-tong-quat.webp\",publishedAt:\"2026-10-10T04:00:00.000Z\",tags:[\"h\\u1ED3 s\\u01A1 s\\u1EE9c kh\\u1ECFe\",\"s\\xE0ng l\\u1ECDc\",\"b\\u1EC7nh m\\u1EA1n t\\xEDnh\"],sourceName:\"VnExpress S\\u1EE9c kh\\u1ECFe, 10/10/2026\",sourceUrl:\"https://vnexpress.net/benh-nao-pho-bien-trong-hon-5-trieu-nguoi-tp-hcm-co-ho-so-suc-khoe-5130654.html\",sections:[{heading:\"D\\u1EEF li\\u1EC7u gi\\xFAp nh\\xECn th\\u1EA5y nh\\xF3m c\\u1EA7n theo d\\xF5i\",paragraphs:[\"\\u0110\\u1EBFn ng\\xE0y 10/10/2026, TP.HCM ghi nh\\u1EADn h\\u01A1n 5,37 tri\\u1EC7u ng\\u01B0\\u1EDDi c\\xF3 h\\u1ED3 s\\u01A1 s\\u1EE9c kh\\u1ECFe \\u0111i\\u1EC7n t\\u1EED qua ch\\u01B0\\u01A1ng tr\\xECnh kh\\xE1m s\\u1EE9c kh\\u1ECFe c\\u1ED9ng \\u0111\\u1ED3ng. Ph\\xE2n t\\xEDch b\\u01B0\\u1EDBc \\u0111\\u1EA7u tr\\xEAn c\\xE1c h\\u1ED3 s\\u01A1 \\u0111\\u1EE7 \\u0111i\\u1EC1u ki\\u1EC7n cho th\\u1EA5y \\u1EDF nh\\xF3m tr\\xEAn 40 tu\\u1ED5i, g\\u1EA7n 15% \\u0111\\u01B0\\u1EE3c ph\\xE2n t\\u1EA7ng nguy c\\u01A1 tim m\\u1EA1ch cao v\\xE0 16% \\u1EDF m\\u1EE9c r\\u1EA5t cao. Nh\\u1EEFng t\\u1EF7 l\\u1EC7 n\\xE0y ch\\u1EC9 ph\\u1EA3n \\xE1nh nh\\xF3m d\\u1EEF li\\u1EC7u \\u0111\\u01B0\\u1EE3c ph\\xE2n t\\xEDch, kh\\xF4ng ph\\u1EA3i t\\u1EF7 l\\u1EC7 b\\u1EC7nh c\\u1EE7a to\\xE0n b\\u1ED9 d\\xE2n s\\u1ED1 th\\xE0nh ph\\u1ED1.\",\"D\\u1EEF li\\u1EC7u c\\u0169ng g\\u1EE3i \\xFD nh\\u1EEFng v\\u1EA5n \\u0111\\u1EC1 c\\u1EA7n theo d\\xF5i v\\u1EC1 ch\\u1EE9c n\\u0103ng th\\u1EADn v\\xE0 \\u0111\\u01B0\\u1EDDng huy\\u1EBFt. \\u1EDE ng\\u01B0\\u1EDDi tr\\u01B0\\u1EDFng th\\xE0nh ch\\u01B0a t\\u1EEBng \\u0111\\u01B0\\u1EE3c ch\\u1EA9n \\u0111o\\xE1n \\u0111\\xE1i th\\xE1o \\u0111\\u01B0\\u1EDDng, m\\u1ED9t ph\\u1EA7n k\\u1EBFt qu\\u1EA3 \\u0111\\u01B0\\u1EDDng huy\\u1EBFt l\\xFAc \\u0111\\xF3i n\\u1EB1m \\u1EDF ng\\u01B0\\u1EE1ng c\\u1EA7n \\u0111\\xE1nh gi\\xE1 th\\xEAm. Ch\\u1EC9 s\\u1ED1 s\\xE0ng l\\u1ECDc l\\xE0 \\u0111i\\u1EC3m kh\\u1EDFi \\u0111\\u1EA7u cho t\\u01B0 v\\u1EA5n v\\xE0 ki\\u1EC3m tra ti\\u1EBFp, kh\\xF4ng \\u0111\\u1EE7 \\u0111\\u1EC3 t\\u1EF1 x\\xE1c \\u0111\\u1ECBnh b\\u1EC7nh hay t\\u1EF1 d\\xF9ng thu\\u1ED1c.\"]},{heading:\"Sau kh\\xE1m s\\u1EE9c kh\\u1ECFe n\\xEAn l\\xE0m g\\xEC?\",paragraphs:[\"Ng\\u01B0\\u1EDDi \\u0111i kh\\xE1m n\\xEAn l\\u01B0u k\\u1EBFt qu\\u1EA3, h\\u1ECFi nh\\xE2n vi\\xEAn y t\\u1EBF ch\\u1EC9 s\\u1ED1 n\\xE0o b\\u1EA5t th\\u01B0\\u1EDDng v\\xE0 c\\xF3 c\\u1EA7n \\u0111o l\\u1EA1i, l\\xE0m x\\xE9t nghi\\u1EC7m x\\xE1c nh\\u1EADn ho\\u1EB7c kh\\xE1m chuy\\xEAn khoa hay kh\\xF4ng. V\\u1EDBi nguy c\\u01A1 tim m\\u1EA1ch, b\\xE1c s\\u0129 th\\u01B0\\u1EDDng xem nhi\\u1EC1u y\\u1EBFu t\\u1ED1 c\\xF9ng l\\xFAc nh\\u01B0 tu\\u1ED5i, huy\\u1EBFt \\xE1p, \\u0111\\u01B0\\u1EDDng huy\\u1EBFt, m\\u1EE1 m\\xE1u v\\xE0 ti\\u1EC1n s\\u1EED. M\\u1ED9t con s\\u1ED1 ri\\xEAng l\\u1EBB kh\\xF3 ph\\u1EA3n \\xE1nh \\u0111\\u1EA7y \\u0111\\u1EE7 nguy c\\u01A1 c\\u1EE7a t\\u1EEBng ng\\u01B0\\u1EDDi.\"]},{heading:\"Gi\\xE1 tr\\u1ECB n\\u1EB1m \\u1EDF theo d\\xF5i li\\xEAn t\\u1EE5c\",paragraphs:[\"H\\u1ED3 s\\u01A1 \\u0111i\\u1EC7n t\\u1EED c\\xF3 \\xEDch khi k\\u1EBFt qu\\u1EA3 kh\\xE1m m\\u1EDBi \\u0111\\u01B0\\u1EE3c n\\u1ED1i v\\u1EDBi l\\u1EA7n kh\\xE1m tr\\u01B0\\u1EDBc v\\xE0 m\\u1ED9t k\\u1EBF ho\\u1EA1ch theo d\\xF5i c\\u1EE5 th\\u1EC3. Nh\\xE2n vi\\xEAn y t\\u1EBF c\\xF3 th\\u1EC3 \\u01B0u ti\\xEAn li\\xEAn h\\u1EC7 nh\\xF3m nguy c\\u01A1 cao, h\\u01B0\\u1EDBng d\\u1EABn thay \\u0111\\u1ED5i l\\u1ED1i s\\u1ED1ng, nh\\u1EAFc t\\xE1i kh\\xE1m v\\xE0 chuy\\u1EC3n kh\\xE1m khi c\\u1EA7n. Ng\\u01B0\\u1EDDi d\\xE2n c\\u0169ng n\\xEAn c\\u1EADp nh\\u1EADt th\\xF4ng tin s\\u1EE9c kh\\u1ECFe ch\\xEDnh x\\xE1c \\u0111\\u1EC3 tr\\xE1nh hi\\u1EC3u sai k\\u1EBFt qu\\u1EA3 ph\\xE2n t\\xEDch.\",\"Kh\\xE1m s\\u1EE9c kh\\u1ECFe \\u0111\\u1ECBnh k\\u1EF3 kh\\xF4ng k\\u1EBFt th\\xFAc \\u1EDF vi\\u1EC7c nh\\u1EADn t\\u1EDD k\\u1EBFt qu\\u1EA3. H\\xE3y trao \\u0111\\u1ED5i v\\u1EC1 m\\u1EE5c ti\\xEAu s\\u1EE9c kh\\u1ECFe ph\\xF9 h\\u1EE3p, nh\\u1EEFng thay \\u0111\\u1ED5i kh\\u1EA3 thi trong \\u0103n u\\u1ED1ng v\\xE0 v\\u1EADn \\u0111\\u1ED9ng, c\\xF9ng th\\u1EDDi \\u0111i\\u1EC3m ki\\u1EC3m tra l\\u1EA1i. C\\xE1ch l\\xE0m n\\xE0y bi\\u1EBFn d\\u1EEF li\\u1EC7u s\\xE0ng l\\u1ECDc th\\xE0nh h\\xE0nh \\u0111\\u1ED9ng ph\\xF2ng b\\u1EC7nh th\\u1EF1c t\\u1EBF v\\xE0 gi\\xFAp ph\\xE1t hi\\u1EC7n b\\u1EC7nh m\\u1EA1n t\\xEDnh tr\\u01B0\\u1EDBc khi xu\\u1EA5t hi\\u1EC7n bi\\u1EBFn ch\\u1EE9ng.\"]}]},{slug:\"nguoi-dai-thao-duong-nen-kham-mat-dinh-ky\",title:\"Ng\\u01B0\\u1EDDi \\u0111\\xE1i th\\xE1o \\u0111\\u01B0\\u1EDDng n\\xEAn kh\\xE1m m\\u1EAFt \\u0111\\u1ECBnh k\\u1EF3 \\u0111\\u1EC3 ph\\xE1t hi\\u1EC7n bi\\u1EBFn ch\\u1EE9ng s\\u1EDBm\",excerpt:\"B\\u1EC7nh l\\xFD v\\xF5ng m\\u1EA1c c\\xF3 th\\u1EC3 ti\\u1EBFn tri\\u1EC3n \\xE2m th\\u1EA7m; kh\\xE1m m\\u1EAFt theo h\\u1EB9n gi\\xFAp ph\\xE1t hi\\u1EC7n v\\xE0 \\u0111i\\u1EC1u tr\\u1ECB tr\\u01B0\\u1EDBc khi th\\u1ECB l\\u1EF1c gi\\u1EA3m r\\xF5.\",category:\"y-hoc-thuong-thuc\",coverUrl:\"/images/minh-hoa/ck-mat.webp\",publishedAt:\"2026-10-01T10:44:00.000Z\",tags:[\"\\u0111\\xE1i th\\xE1o \\u0111\\u01B0\\u1EDDng\",\"m\\u1EAFt\",\"kh\\xE1m \\u0111\\u1ECBnh k\\u1EF3\"],sourceName:\"S\\u1EE9c kh\\u1ECFe & \\u0110\\u1EDDi s\\u1ED1ng, 01/10/2026\",sourceUrl:\"https://suckhoedoisong.vn/vi-doi-mat-viet-quan-ly-toan-dien-phat-hien-som-bien-chung-mat-do-dai-thao-duong-169261001170716817.htm\",sections:[{heading:\"Bi\\u1EBFn ch\\u1EE9ng m\\u1EAFt c\\xF3 th\\u1EC3 \\u0111\\u1EBFn \\xE2m th\\u1EA7m\",paragraphs:[\"B\\u1EC7nh v\\xF5ng m\\u1EA1c v\\xE0 ph\\xF9 ho\\xE0ng \\u0111i\\u1EC3m l\\xE0 nh\\u1EEFng bi\\u1EBFn ch\\u1EE9ng m\\u1EAFt quan tr\\u1ECDng \\u1EDF ng\\u01B0\\u1EDDi \\u0111\\xE1i th\\xE1o \\u0111\\u01B0\\u1EDDng. Giai \\u0111o\\u1EA1n \\u0111\\u1EA7u, ng\\u01B0\\u1EDDi b\\u1EC7nh c\\xF3 th\\u1EC3 v\\u1EABn \\u0111\\u1ECDc, l\\xE0m vi\\u1EC7c v\\xE0 sinh ho\\u1EA1t nh\\u01B0 th\\u01B0\\u1EDDng n\\xEAn kh\\xF4ng nh\\u1EADn th\\u1EA5y t\\u1ED5n th\\u01B0\\u01A1ng \\u0111ang xu\\u1EA5t hi\\u1EC7n. Khi th\\u1ECB l\\u1EF1c gi\\u1EA3m r\\xF5 m\\u1EDBi \\u0111i kh\\xE1m, c\\u01A1 h\\u1ED9i b\\u1EA3o t\\u1ED3n th\\u1ECB l\\u1EF1c c\\xF3 th\\u1EC3 \\xEDt h\\u01A1n. Th\\xF4ng tin t\\u1EA1i m\\u1ED9t h\\u1ED9i th\\u1EA3o y t\\u1EBF \\u0111\\u1EA7u th\\xE1ng 10/2026 nh\\u1EA5n m\\u1EA1nh ph\\u1EA7n l\\u1EDBn tr\\u01B0\\u1EDDng h\\u1EE3p m\\u1EA5t th\\u1ECB l\\u1EF1c li\\xEAn quan \\u0111\\xE1i th\\xE1o \\u0111\\u01B0\\u1EDDng c\\xF3 th\\u1EC3 ph\\xF2ng ng\\u1EEBa ho\\u1EB7c \\u0111i\\u1EC1u tr\\u1ECB hi\\u1EC7u qu\\u1EA3 n\\u1EBFu ph\\xE1t hi\\u1EC7n s\\u1EDBm.\",\"\\u0110\\u01B0\\u1EDDng huy\\u1EBFt cao k\\xE9o d\\xE0i \\u1EA3nh h\\u01B0\\u1EDFng \\u0111\\u1EBFn c\\xE1c m\\u1EA1ch m\\xE1u nh\\u1ECF \\u1EDF v\\xF5ng m\\u1EA1c. Tuy nhi\\xEAn, m\\u1EE9c \\u0111\\u1ED9 t\\u1ED5n th\\u01B0\\u01A1ng m\\u1EAFt kh\\xF4ng th\\u1EC3 suy ra ch\\u1EC9 t\\u1EEB c\\u1EA3m gi\\xE1c nh\\xECn r\\xF5 hay m\\u1EDD. V\\xEC v\\u1EADy, ng\\u01B0\\u1EDDi b\\u1EC7nh c\\u1EA7n \\u0111\\u01B0\\u1EE3c \\u0111\\xE1nh gi\\xE1 m\\u1EAFt theo l\\u1ECBch b\\xE1c s\\u0129 ch\\u1EC9 \\u0111\\u1ECBnh, k\\u1EC3 c\\u1EA3 khi ch\\u01B0a c\\xF3 tri\\u1EC7u ch\\u1EE9ng v\\xE0 \\u0111ang ki\\u1EC3m so\\xE1t \\u0111\\u01B0\\u1EDDng huy\\u1EBFt t\\u01B0\\u01A1ng \\u0111\\u1ED1i t\\u1ED1t.\"]},{heading:\"Kh\\xE1m m\\u1EAFt l\\xE0 m\\u1ED9t ph\\u1EA7n c\\u1EE7a qu\\u1EA3n l\\xFD b\\u1EC7nh\",paragraphs:[\"T\\xE0i li\\u1EC7u \\u0111\\u01B0\\u1EE3c S\\u1EE9c kh\\u1ECFe & \\u0110\\u1EDDi s\\u1ED1ng \\u0111\\u01B0a tin khuy\\u1EBFn kh\\xEDch ng\\u01B0\\u1EDDi m\\u1EAFc \\u0111\\xE1i th\\xE1o \\u0111\\u01B0\\u1EDDng h\\xECnh th\\xE0nh th\\xF3i quen kh\\xE1m m\\u1EAFt \\u0111\\u1ECBnh k\\u1EF3, th\\u01B0\\u1EDDng \\xEDt nh\\u1EA5t m\\u1ED7i n\\u0103m m\\u1ED9t l\\u1EA7n; th\\u1EDDi \\u0111i\\u1EC3m c\\u1EE5 th\\u1EC3 c\\xF3 th\\u1EC3 kh\\xE1c theo lo\\u1EA1i b\\u1EC7nh, t\\xECnh tr\\u1EA1ng m\\u1EAFt v\\xE0 thai k\\u1EF3. B\\xE1c s\\u0129 s\\u1EBD h\\u01B0\\u1EDBng d\\u1EABn c\\xE1ch ki\\u1EC3m tra ph\\xF9 h\\u1EE3p, nh\\u01B0 quan s\\xE1t \\u0111\\xE1y m\\u1EAFt, v\\xE0 quy\\u1EBFt \\u0111\\u1ECBnh khi n\\xE0o c\\u1EA7n theo d\\xF5i s\\xE1t ho\\u1EB7c \\u0111i\\u1EC1u tr\\u1ECB.\"]},{heading:\"Chu\\u1EA9n b\\u1ECB cho l\\u1EA7n kh\\xE1m v\\xE0 theo d\\xF5i sau \\u0111\\xF3\",paragraphs:[\"Khi \\u0111i kh\\xE1m, n\\xEAn mang theo k\\u1EBFt qu\\u1EA3 \\u0111\\u01B0\\u1EDDng huy\\u1EBFt g\\u1EA7n \\u0111\\xE2y, danh s\\xE1ch thu\\u1ED1c, h\\u1ED3 s\\u01A1 m\\u1EAFt c\\u0169 v\\xE0 ghi l\\u1EA1i nh\\u1EEFng thay \\u0111\\u1ED5i v\\u1EC1 th\\u1ECB l\\u1EF1c. B\\xEAn c\\u1EA1nh kh\\xE1m m\\u1EAFt, vi\\u1EC7c ki\\u1EC3m so\\xE1t \\u0111\\u01B0\\u1EDDng huy\\u1EBFt, huy\\u1EBFt \\xE1p v\\xE0 m\\u1EE1 m\\xE1u theo k\\u1EBF ho\\u1EA1ch \\u0111i\\u1EC1u tr\\u1ECB gi\\xFAp gi\\u1EA3m nguy c\\u01A1 bi\\u1EBFn ch\\u1EE9ng. Kh\\xF4ng t\\u1EF1 b\\u1ECF thu\\u1ED1c v\\xEC th\\u1EA5y m\\u1EAFt v\\u1EABn b\\xECnh th\\u01B0\\u1EDDng.\",\"N\\u1EBFu \\u0111\\u1ED9t ng\\u1ED9t nh\\xECn m\\u1EDD, th\\u1EA5y nhi\\u1EC1u ch\\u1EA5m \\u0111en m\\u1EDBi, ch\\u1EDBp s\\xE1ng ho\\u1EB7c m\\u1EA5t m\\u1ED9t ph\\u1EA7n th\\u1ECB tr\\u01B0\\u1EDDng, c\\u1EA7n \\u0111\\u01B0\\u1EE3c kh\\xE1m s\\u1EDBm. T\\u1EA7m so\\xE1t \\u0111\\u1ECBnh k\\u1EF3 t\\u1EA1o c\\u01A1 h\\u1ED9i can thi\\u1EC7p tr\\u01B0\\u1EDBc khi th\\u1ECB l\\u1EF1c suy gi\\u1EA3m, \\u0111\\u1ED3ng th\\u1EDDi gi\\xFAp b\\xE1c s\\u0129 n\\u1ED9i khoa v\\xE0 b\\xE1c s\\u0129 m\\u1EAFt ph\\u1ED1i h\\u1EE3p theo d\\xF5i ng\\u01B0\\u1EDDi b\\u1EC7nh l\\xE2u d\\xE0i.\"]}]}];const guides=[{slug:\"huong-dan-quy-trinh-di-kham\",title:\"Quy tr\\xECnh \\u0111i kh\\xE1m\",blocks:[paragraph(\"Quy tr\\xECnh d\\u01B0\\u1EDBi \\u0111\\xE2y gi\\xFAp b\\u1EA1n chu\\u1EA9n b\\u1ECB cho m\\u1ED9t l\\u1EA7n kh\\xE1m ngo\\u1EA1i tr\\xFA th\\xF4ng th\\u01B0\\u1EDDng. T\\u1EEBng b\\u1EC7nh vi\\u1EC7n c\\xF3 th\\u1EC3 b\\u1ED1 tr\\xED qu\\u1EA7y, ph\\xF2ng kh\\xE1m v\\xE0 gi\\u1EDD ti\\u1EBFp nh\\u1EADn kh\\xE1c nhau; h\\xE3y ki\\u1EC3m tra th\\xF4ng tin tr\\xEAn phi\\u1EBFu h\\u1EB9n ho\\u1EB7c h\\u1ECFi nh\\xE2n vi\\xEAn h\\u01B0\\u1EDBng d\\u1EABn t\\u1EA1i n\\u01A1i kh\\xE1m.\"),heading(\"1. \\u0110\\u1EB7t l\\u1ECBch v\\xE0 chu\\u1EA9n b\\u1ECB tr\\u01B0\\u1EDBc khi \\u0111i\"),paragraph(\"Ch\\u1ECDn c\\u01A1 s\\u1EDF y t\\u1EBF, chuy\\xEAn khoa, ng\\xE0y v\\xE0 khung gi\\u1EDD c\\xF2n nh\\u1EADn kh\\xE1m tr\\xEAn website. Xem l\\u1EA1i h\\u1ECD t\\xEAn, th\\xF4ng tin ng\\u01B0\\u1EDDi b\\u1EC7nh, h\\xECnh th\\u1EE9c kh\\xE1m v\\xE0 ph\\u01B0\\u01A1ng th\\u1EE9c thanh to\\xE1n tr\\u01B0\\u1EDBc khi x\\xE1c nh\\u1EADn. L\\u01B0u m\\xE3 phi\\u1EBFu ho\\u1EB7c \\u1EA3nh ch\\u1EE5p m\\xE0n h\\xECnh \\u0111\\u1EC3 xu\\u1EA5t tr\\xECnh khi \\u0111\\u1EBFn b\\u1EC7nh vi\\u1EC7n.\"),list([\"Mang CCCD ho\\u1EB7c gi\\u1EA5y t\\u1EDD \\u0111\\u1ECBnh danh ph\\xF9 h\\u1EE3p, phi\\u1EBFu h\\u1EB9n v\\xE0 h\\u1ED3 s\\u01A1 kh\\xE1m c\\u0169 n\\u1EBFu c\\xF3.\",\"N\\u1EBFu kh\\xE1m BHYT, chu\\u1EA9n b\\u1ECB th\\xF4ng tin th\\u1EBB BHYT ho\\u1EB7c gi\\u1EA5y t\\u1EDD c\\xF3 th\\u1EC3 tra c\\u1EE9u BHYT, gi\\u1EA5y chuy\\u1EC3n c\\u01A1 s\\u1EDF kh\\xE1m ch\\u1EEFa b\\u1EC7nh hay gi\\u1EA5y h\\u1EB9n t\\xE1i kh\\xE1m khi \\u0111\\u01B0\\u1EE3c y\\xEAu c\\u1EA7u.\",\"Ghi l\\u1EA1i thu\\u1ED1c \\u0111ang d\\xF9ng, ti\\u1EC1n s\\u1EED d\\u1ECB \\u1EE9ng v\\xE0 c\\xE1c c\\xE2u h\\u1ECFi mu\\u1ED1n h\\u1ECFi b\\xE1c s\\u0129. Ch\\u1EC9 nh\\u1ECBn \\u0103n khi \\u0111\\xE3 \\u0111\\u01B0\\u1EE3c d\\u1EB7n tr\\u01B0\\u1EDBc cho x\\xE9t nghi\\u1EC7m ho\\u1EB7c th\\u1EE7 thu\\u1EADt.\"]),heading(\"2. \\u0110\\u1EBFn b\\u1EC7nh vi\\u1EC7n v\\xE0 x\\xE1c nh\\u1EADn \\u0111\\u0103ng k\\xFD\"),paragraph(\"\\u0110\\u1EBFn tr\\u01B0\\u1EDBc gi\\u1EDD h\\u1EB9n theo h\\u01B0\\u1EDBng d\\u1EABn tr\\xEAn phi\\u1EBFu. T\\u1EA1i khu ti\\u1EBFp \\u0111\\xF3n, xu\\u1EA5t tr\\xECnh m\\xE3 \\u0111\\u1EB7t kh\\xE1m v\\xE0 gi\\u1EA5y t\\u1EDD \\u0111\\u1EC3 nh\\xE2n vi\\xEAn \\u0111\\u1ED1i chi\\u1EBFu th\\xF4ng tin. Ng\\u01B0\\u1EDDi kh\\xE1m BHYT c\\u1EA7n ho\\xE0n t\\u1EA5t b\\u01B0\\u1EDBc ki\\u1EC3m tra quy\\u1EC1n l\\u1EE3i t\\u1EA1i qu\\u1EA7y ph\\xF9 h\\u1EE3p; \\u0111\\u1EB7t l\\u1ECBch tr\\u1EF1c tuy\\u1EBFn kh\\xF4ng t\\u1EF1 \\u0111\\u1ED9ng x\\xE1c nh\\u1EADn m\\u1EE9c h\\u01B0\\u1EDFng BHYT.\"),heading(\"3. L\\u1EA5y s\\u1ED1 v\\xE0 v\\xE0o ph\\xF2ng kh\\xE1m\"),paragraph(\"Nh\\u1EADn s\\u1ED1 th\\u1EE9 t\\u1EF1 ho\\u1EB7c phi\\u1EBFu ph\\xF2ng kh\\xE1m theo h\\u01B0\\u1EDBng d\\u1EABn. Theo d\\xF5i b\\u1EA3ng g\\u1ECDi s\\u1ED1 v\\xE0 \\u0111\\u1EBFn \\u0111\\xFAng ph\\xF2ng. B\\xE1c s\\u0129 h\\u1ECFi b\\u1EC7nh, kh\\xE1m l\\xE2m s\\xE0ng, xem h\\u1ED3 s\\u01A1 c\\u0169 v\\xE0 t\\u01B0 v\\u1EA5n b\\u01B0\\u1EDBc ti\\u1EBFp theo. Th\\u1EE9 t\\u1EF1 th\\u1EF1c t\\u1EBF c\\xF3 th\\u1EC3 thay \\u0111\\u1ED5i v\\u1EDBi tr\\u01B0\\u1EDDng h\\u1EE3p c\\u1EA5p c\\u1EE9u ho\\u1EB7c \\u01B0u ti\\xEAn theo quy \\u0111\\u1ECBnh.\"),heading(\"4. Th\\u1EF1c hi\\u1EC7n c\\u1EADn l\\xE2m s\\xE0ng n\\u1EBFu c\\xF3 ch\\u1EC9 \\u0111\\u1ECBnh\"),paragraph(\"N\\u1EBFu b\\xE1c s\\u0129 ch\\u1EC9 \\u0111\\u1ECBnh x\\xE9t nghi\\u1EC7m, ch\\u1EA9n \\u0111o\\xE1n h\\xECnh \\u1EA3nh ho\\u1EB7c th\\u0103m d\\xF2 ch\\u1EE9c n\\u0103ng, h\\xE3y l\\xE0m th\\u1EE7 t\\u1EE5c t\\u1EA1i qu\\u1EA7y ho\\u1EB7c tr\\xEAn h\\u1EC7 th\\u1ED1ng theo h\\u01B0\\u1EDBng d\\u1EABn, thanh to\\xE1n ph\\u1EA7n c\\u1EA7n thi\\u1EBFt r\\u1ED3i \\u0111\\u1EBFn \\u0111\\xFAng khu th\\u1EF1c hi\\u1EC7n. Gi\\u1EEF phi\\u1EBFu ch\\u1EC9 \\u0111\\u1ECBnh v\\xE0 h\\u1ECFi th\\u1EDDi gian tr\\u1EA3 k\\u1EBFt qu\\u1EA3. Kh\\xF4ng t\\u1EF1 l\\xE0m x\\xE9t nghi\\u1EC7m ngo\\xE0i ch\\u1EC9 \\u0111\\u1ECBnh r\\u1ED3i b\\u1ECF qua b\\u01B0\\u1EDBc b\\xE1c s\\u0129 \\u0111\\u1ECDc k\\u1EBFt qu\\u1EA3.\"),heading(\"5. Quay l\\u1EA1i b\\xE1c s\\u0129 v\\xE0 thanh to\\xE1n\"),paragraph(\"Mang k\\u1EBFt qu\\u1EA3 tr\\u1EDF l\\u1EA1i ph\\xF2ng kh\\xE1m \\u0111\\u1EC3 b\\xE1c s\\u0129 k\\u1EBFt lu\\u1EADn, k\\xEA \\u0111\\u01A1n ho\\u1EB7c h\\u1EB9n t\\xE1i kh\\xE1m. Sau \\u0111\\xF3, \\u0111\\u1ED1i chi\\u1EBFu b\\u1EA3ng k\\xEA v\\xE0 thanh to\\xE1n ph\\u1EA7n chi ph\\xED c\\xF2n l\\u1EA1i t\\u1EA1i qu\\u1EA7y hay k\\xEAnh b\\u1EC7nh vi\\u1EC7n h\\u1ED7 tr\\u1EE3. V\\u1EDBi BHYT, m\\u1EE9c qu\\u1EF9 chi tr\\u1EA3 ph\\u1EE5 thu\\u1ED9c \\u0111i\\u1EC1u ki\\u1EC7n h\\u01B0\\u1EDFng, ph\\u1EA1m vi quy\\u1EC1n l\\u1EE3i v\\xE0 lo\\u1EA1i d\\u1ECBch v\\u1EE5; v\\u1EDBi kh\\xE1m d\\u1ECBch v\\u1EE5, ng\\u01B0\\u1EDDi b\\u1EC7nh thanh to\\xE1n theo gi\\xE1 \\u0111\\u01B0\\u1EE3c th\\xF4ng b\\xE1o.\"),heading(\"6. Nh\\u1EADn thu\\u1ED1c v\\xE0 ra v\\u1EC1\"),paragraph(\"Nh\\u1EADn thu\\u1ED1c t\\u1EA1i qu\\u1EA7y theo h\\u01B0\\u1EDBng d\\u1EABn, ki\\u1EC3m tra t\\xEAn thu\\u1ED1c, li\\u1EC1u d\\xF9ng, s\\u1ED1 l\\u01B0\\u1EE3ng v\\xE0 c\\xE1ch s\\u1EED d\\u1EE5ng v\\u1EDBi d\\u01B0\\u1EE3c s\\u0129. Gi\\u1EEF \\u0111\\u01A1n thu\\u1ED1c, h\\xF3a \\u0111\\u01A1n v\\xE0 gi\\u1EA5y h\\u1EB9n. N\\u1EBFu ch\\u01B0a r\\xF5 d\\u1EA5u hi\\u1EC7u c\\u1EA7n quay l\\u1EA1i ho\\u1EB7c c\\xE1ch d\\xF9ng thu\\u1ED1c, h\\xE3y h\\u1ECFi tr\\u01B0\\u1EDBc khi r\\u1EDDi b\\u1EC7nh vi\\u1EC7n.\"),{type:\"callout\",tone:\"warning\",title:\"Khi c\\u1EA7n c\\u1EA5p c\\u1EE9u\",content:[{text:\"N\\u1EBFu c\\xF3 kh\\xF3 th\\u1EDF, \\u0111au ng\\u1EF1c, b\\u1EA5t t\\u1EC9nh, y\\u1EBFu li\\u1EC7t \\u0111\\u1ED9t ng\\u1ED9t ho\\u1EB7c d\\u1EA5u hi\\u1EC7u nguy hi\\u1EC3m kh\\xE1c, h\\xE3y \\u0111\\u1EBFn khu c\\u1EA5p c\\u1EE9u ngay; kh\\xF4ng ch\\u1EDD quy tr\\xECnh kh\\xE1m theo l\\u1ECBch.\"}]}]},{slug:\"huong-dan-dat-lich-kham-online\",title:\"H\\u01B0\\u1EDBng d\\u1EABn \\u0111\\u1EB7t l\\u1ECBch kh\\xE1m online\",blocks:[paragraph(\"\\u0110\\u1EB7t l\\u1ECBch tr\\u1EF1c tuy\\u1EBFn gi\\xFAp b\\u1EA1n ch\\u1ECDn th\\u1EDDi gian ph\\xF9 h\\u1EE3p v\\xE0 chu\\u1EA9n b\\u1ECB h\\u1ED3 s\\u01A1 tr\\u01B0\\u1EDBc khi \\u0111\\u1EBFn vi\\u1EC7n. L\\u1ECBch tr\\u1ED1ng, chuy\\xEAn khoa v\\xE0 c\\xE1ch nh\\u1EADn phi\\u1EBFu t\\xF9y t\\u1EEBng c\\u01A1 s\\u1EDF.\"),heading(\"C\\xE1c b\\u01B0\\u1EDBc \\u0111\\u1EB7t l\\u1ECBch\"),list([\"M\\u1EDF m\\u1EE5c \\u0110\\u1EB7t kh\\xE1m, ch\\u1ECDn c\\u01A1 s\\u1EDF y t\\u1EBF v\\xE0 chuy\\xEAn khoa ph\\xF9 h\\u1EE3p v\\u1EDBi nhu c\\u1EA7u.\",\"\\u0110\\u0103ng nh\\u1EADp ho\\u1EB7c t\\u1EA1o t\\xE0i kho\\u1EA3n, ki\\u1EC3m tra th\\xF4ng tin ng\\u01B0\\u1EDDi \\u0111i kh\\xE1m \\u0111\\u1EC3 h\\u1ED3 s\\u01A1 kh\\u1EDBp gi\\u1EA5y t\\u1EDD.\",\"Ch\\u1ECDn ng\\xE0y, khung gi\\u1EDD v\\xE0 h\\xECnh th\\u1EE9c kh\\xE1m \\u0111ang \\u0111\\u01B0\\u1EE3c c\\u01A1 s\\u1EDF h\\u1ED7 tr\\u1EE3.\",\"Xem l\\u1EA1i chi ph\\xED d\\u1EF1 ki\\u1EBFn, ph\\u01B0\\u01A1ng th\\u1EE9c thanh to\\xE1n, \\u0111i\\u1EC1u ki\\u1EC7n h\\u1EE7y v\\xE0 x\\xE1c nh\\u1EADn phi\\u1EBFu.\",\"L\\u01B0u m\\xE3 phi\\u1EBFu, theo d\\xF5i tr\\u1EA1ng th\\xE1i trong t\\xE0i kho\\u1EA3n v\\xE0 \\u0111\\u1EBFn vi\\u1EC7n theo gi\\u1EDD h\\u1EB9n.\"],true),paragraph(\"L\\u1ECBch h\\u1EB9n \\u0111\\u01B0\\u1EE3c xem l\\xE0 ho\\xE0n t\\u1EA5t khi h\\u1EC7 th\\u1ED1ng hi\\u1EC3n th\\u1ECB phi\\u1EBFu v\\xE0 tr\\u1EA1ng th\\xE1i t\\u01B0\\u01A1ng \\u1EE9n