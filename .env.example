# ==== MQ Solutions – biến môi trường (xem 00-CONG-NGHE-QUY-UOC mục 13) ====
# Copy thành .env rồi điền. KHÔNG commit .env.

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug
APP_VERSION=dev

# PostgreSQL 16 / Redis 7 (docker/docker-compose.dev.yml)
DATABASE_URL=postgresql://mq:mq@localhost:5434/mq_solutions?schema=public
REDIS_URL=redis://localhost:6380

# Khóa ký / mã hóa – mỗi khóa ≥ 32 ký tự ngẫu nhiên. Tạo mới: node scripts/gen-secrets.mjs
JWT_SECRET=change-me-jwt-secret-at-least-32-characters-long
ADMIN_SESSION_SECRET=change-me-admin-secret-at-least-32-characters
PII_SECRET=change-me-pii-aes-256-gcm-key-at-least-32-chars
PII_HMAC_SECRET=change-me-pii-hmac-key-at-least-32-characters

# Gmail SMTP: smtp.gmail.com, cổng 587, SMTP_SECURE=false (STARTTLS), SMTP_PASSWORD = mật khẩu ứng dụng 16 ký tự.
# Dev không muốn gửi mail thật: SMTP_HOST=localhost, SMTP_PORT=1025 (Mailpit, xem http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Gmail: SMTP_FROM phải là chính tài khoản SMTP_USER hoặc alias đã xác minh
SMTP_FROM="MQ Solutions <no-reply@mqsolutions.vn>"

# Lưu tệp trên ổ đĩa server (ảnh cơ sở, banner, bài viết). Production: mount volume vào thư mục này.
#   <STORAGE_DIR>/public  → phục vụ công khai tại /uploads/...
#   <STORAGE_DIR>/private → không phục vụ ra ngoài
STORAGE_DIR=./storage

# Cloudflare Turnstile (CAPTCHA). Để trống ở máy dev = tắt; production bắt buộc.
# Khóa test luôn đúng của Cloudflare: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Bí mật theo cơ sở: tên biến do admin nhập ở A02 (facility.secret_ref / webhook_key_ref) ----
# Khóa 3DES ApiDatKham của từng cơ sở (lấy từ đội HIS, KHÔNG commit giá trị thật)
HIS_KEY_BVAB=
HIS_KEY_BVTD=
HIS_KEY_BVNB=
HIS_KEY_BVCC=
# URL ApiDatKham khi seed. Bỏ trống = IP nội bộ http://192.168.1.250:900x (máy chủ đặt trong mạng BV).
# Máy dev ngoài mạng: http://mqsoft.ddns.net:9001 (An Bình) / 9002 (Thủ Đức) / 9003 (Nhà Bè) / 9004 (Củ Chi)
HIS_URL_BVAB=
HIS_URL_BVTD=
HIS_URL_BVNB=
HIS_URL_BVCC=
# Cơ sở mẫu BVA/BVB trỏ tới mock ApiDatKham (chỉ dev/test)
SEED_MOCK_FACILITIES=false
HIS_KEY_BVA=mock-his-key-bva
HIS_KEY_BVB=mock-his-key-bvb
# Khóa webhook SePay của từng cơ sở
SEPAY_WEBHOOK_KEY_BVA=mock-sepay-key-bva
SEPAY_WEBHOOK_KEY_BVB=mock-sepay-key-bvb

# Mock ApiDatKham khi chạy local (pnpm mock:his)
MOCK_HIS_PORT=4010

# Tùy chọn cho db:seed và admin:reset. Không khai báo EMAIL sẽ dùng tài khoản mặc định.
# Không khai báo PASSWORD để db:seed tự sinh mật khẩu; không bật dòng này với giá trị trống.
# SEED_ADMIN_EMAIL=admin@mqsolutions.local
# SEED_ADMIN_PASSWORD=

# W06W07 – email bộ phận kinh doanh nhận liên hệ hợp tác (nếu trống dùng SMTP_FROM)
CONTACT_SALES_EMAIL=

# W06W07 – URL hỗ trợ chính thức; để trống sẽ ẩn kênh tương ứng
SUPPORT_ZALO_URL=
SUPPORT_FACEBOOK_URL=

# G3ANALYTICS – origin HTTPS của Umami tự host; để trống nếu chọn GA4 hoặc tắt.
UMAMI_ORIGIN=
